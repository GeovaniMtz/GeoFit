  "fixed_sql": [
    {
      "name": "ejercicios",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ejercicios\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"nombre\" TEXT NOT NULL, \"grupo_muscular\" TEXT NOT NULL, \"equipo\" TEXT NOT NULL DEFAULT '', \"es_personalizado\" INTEGER NOT NULL DEFAULT 0 CHECK (\"es_personalizado\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "rutinas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rutinas\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"nombre\" TEXT NOT NULL, \"activa\" INTEGER NOT NULL DEFAULT 1 CHECK (\"activa\" IN (0, 1)), \"creada_en\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "rutina_dias",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rutina_dias\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"rutina_id\" INTEGER NOT NULL REFERENCES rutinas (id) ON DELETE CASCADE, \"nombre_dia\" TEXT NOT NULL, \"orden\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "rutina_ejercicios",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rutina_ejercicios\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"rutina_dia_id\" INTEGER NOT NULL REFERENCES rutina_dias (id) ON DELETE CASCADE, \"ejercicio_id\" INTEGER NOT NULL REFERENCES ejercicios (id), \"orden\" INTEGER NOT NULL DEFAULT 0, \"series_objetivo\" INTEGER NOT NULL DEFAULT 3, \"reps_min\" INTEGER NOT NULL DEFAULT 8, \"reps_max\" INTEGER NOT NULL DEFAULT 12, \"descanso_seg\" INTEGER NOT NULL DEFAULT 90);"
        }
      ]
    },
    {
      "name": "sesiones_entrenamiento",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sesiones_entrenamiento\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"rutina_dia_id\" INTEGER NOT NULL REFERENCES rutina_dias (id), \"fecha\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"duracion_seg\" INTEGER NULL, \"notas\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "registros_set",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"registros_set\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"sesion_id\" INTEGER NOT NULL REFERENCES sesiones_entrenamiento (id) ON DELETE CASCADE, \"rutina_ejercicio_id\" INTEGER NOT NULL REFERENCES rutina_ejercicios (id), \"numero_set\" INTEGER NOT NULL, \"peso\" REAL NOT NULL, \"reps\" INTEGER NOT NULL, \"rpe\" REAL NULL, \"es_pr\" INTEGER NOT NULL DEFAULT 0 CHECK (\"es_pr\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "registros_peso_corporal",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"registros_peso_corporal\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"fecha\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"peso\" REAL NOT NULL, \"nota\" TEXT NULL);"
        }
      ]
    },
